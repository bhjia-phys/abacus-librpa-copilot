{
  "name": "@local/abacusflow",
  "version": "0.1.0",
  "private": true,
  "description": "ABACUS-LibRPA Copilot for DeepSeek Harness: ABACUS + LibRPA (DFT -> GW/QSGW) pipeline view, band and gap comparisons with provenance, per-stage diagnosis, LibRPA-database comparison, and abacus_*/librpa_* agent tools.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/host/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
